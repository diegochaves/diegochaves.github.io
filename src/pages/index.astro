---
import BaseLayout from '../layouts/BaseLayout.astro';
import AgoraBlock from '../components/AgoraBlock.astro';
import CategoryFilter from '../components/CategoryFilter.astro';
import PostLog from '../components/PostLog.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { HOME, SITE } from '../consts';
import { PROJECTS } from '../data/projects';
import { getPosts } from '../utils/posts';

const recentPosts = (await getPosts()).slice(0, 8);
const featuredProjects = PROJECTS.filter((project) => project.featured).slice(0, 3);
---

<BaseLayout title={SITE.title}>
  <p class="font-mono text-xs text-accent sm:text-[13px]">{HOME.eyebrow}</p>
  <h1 class="mt-3 max-w-[720px] text-[28px] leading-[1.2] font-semibold tracking-[-0.02em] sm:text-[40px] sm:leading-[1.15]">
    {HOME.title}
  </h1>
  <p class="mt-3 text-[15px] leading-relaxed text-muted lg:hidden">{SITE.role}. {SITE.bio}</p>

  <CategoryFilter current="tudo" class="mt-7 sm:mt-10" />

  {recentPosts.length === 0 ? (
    <p class="mt-8 text-[15px] text-muted">Nenhum post publicado ainda.</p>
  ) : (
    <PostLog posts={recentPosts} class="mt-7 sm:mt-10" />
  )}
  <a href="/blog/" class="mt-6 inline-block text-[15px]">Ver o arquivo completo →</a>

  {featuredProjects.length > 0 && (
    <section class="mt-12 flex flex-col gap-4 sm:mt-18 sm:gap-6">
      <div class="flex items-baseline justify-between">
        <h2 class="text-xl font-semibold tracking-[-0.01em] sm:text-[22px]">Projetos</h2>
        <a href="/projetos" class="text-[15px]">Ver todos →</a>
      </div>
      <div class="grid gap-3 sm:grid-cols-2 sm:gap-4 xl:grid-cols-3">
        {featuredProjects.map((project) => <ProjectCard project={project} />)}
      </div>
    </section>
  )}

  <AgoraBlock variant="card" class="mt-12 lg:hidden" />
</BaseLayout>

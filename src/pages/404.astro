---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 — Página não encontrada">
  <p class="font-mono text-xs text-accent sm:text-[13px]">erro 404</p>
  <h1 class="mt-3 text-[28px] leading-[1.2] font-semibold tracking-[-0.02em] sm:text-[40px] sm:leading-[1.15]">
    Página não encontrada
  </h1>
  <p class="mt-3 text-[15px] leading-relaxed text-muted">
    A página que procuras não existe ou foi movida.
  </p>
  <a href="/" class="mt-8 inline-block text-[15px]">← Voltar ao início</a>
</BaseLayout>

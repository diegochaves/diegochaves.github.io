---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../consts';
import CategoryFilter from '../../components/CategoryFilter.astro';
import PostLog from '../../components/PostLog.astro';
import { getPosts } from '../../utils/posts';

const posts = await getPosts();
---

<BaseLayout
  title="Blog"
  description={`Todos os posts de ${SITE.author} sobre desenvolvimento, carreira, curiosidades e rotina.`}
>
  <p class="font-mono text-xs text-accent sm:text-[13px]">arquivo</p>
  <h1 class="mt-3 text-[28px] leading-[1.2] font-semibold tracking-[-0.02em] sm:text-[40px] sm:leading-[1.15]">
    Todos os escritos
  </h1>
  <p class="mt-3 text-[15px] text-muted">{posts.length} post{posts.length !== 1 ? 's' : ''}</p>

  <CategoryFilter current="tudo" class="mt-7 sm:mt-10" />

  {posts.length === 0 ? (
    <p class="mt-8 text-[15px] text-muted">Nenhum post publicado ainda.</p>
  ) : (
    <PostLog posts={posts} class="mt-7 sm:mt-10" />
  )}
</BaseLayout>

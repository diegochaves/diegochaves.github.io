---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import CategoryBadge from '../components/CategoryBadge.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { SITE } from '../consts';
import { formatDate, formatDayMonth, getPosts, readingMinutes, type Post } from '../utils/posts';

interface Props {
  post: Post;
  headings: MarkdownHeading[];
}

const { post, headings } = Astro.props;
const { title, date, description, category, tags, resumo } = post.data;

const published = formatDate(date);
const minutes = readingMinutes(post.body);

const toc = [
  ...(resumo ? [{ slug: 'resumo', text: 'Resumo' }] : []),
  ...headings.filter((heading) => heading.depth === 2),
];

const resumoItems = resumo
  ? [
      { label: 'problema', text: resumo.problema },
      ...(resumo.complicou ? [{ label: 'o que complicou', text: resumo.complicou }] : []),
      { label: 'como resolvi', text: resumo.solucao },
    ]
  : [];

// Two more posts, same category first.
const others = (await getPosts()).filter((other) => other.id !== post.id);
const related = [
  ...others.filter((other) => other.data.category === category),
  ...others.filter((other) => other.data.category !== category),
].slice(0, 2);
---

<BaseLayout title={title} description={description}>
  <Fragment slot="sidebar">
    <a href="/blog/" class="font-mono text-[13px]">← caderno</a>

    <dl class="mt-10 grid grid-cols-[88px_minmax(0,1fr)] items-baseline gap-x-3 gap-y-3.5 text-sm">
      <dt class="font-mono text-xs text-muted">publicado</dt>
      <dd><time datetime={date.toISOString()}>{published}</time></dd>
      <dt class="font-mono text-xs text-muted">leitura</dt>
      <dd>{minutes} min</dd>
      <dt class="font-mono text-xs text-muted">categoria</dt>
      <dd><a href={`/blog/categoria/${category}/`} class="hover:no-underline"><CategoryBadge category={category} /></a></dd>
      {tags && tags.length > 0 && (
        <>
          <dt class="font-mono text-xs text-muted">tags</dt>
          <dd class="flex flex-wrap gap-x-2.5 gap-y-1 font-mono text-xs text-muted">
            {tags.map((tag) => <span>#{tag}</span>)}
          </dd>
        </>
      )}
    </dl>

    {toc.length > 1 && (
      <nav aria-label="Neste post" data-toc class="mt-10 flex flex-col gap-1 border-t border-line pt-6">
        <span class="mb-2 font-mono text-xs text-muted">neste post</span>
        {toc.map(({ slug, text }) => (
          <a
            href={`#${slug}`}
            class="group flex min-h-9 items-center gap-2.5 text-sm text-muted hover:text-ink hover:no-underline aria-[current=location]:font-medium aria-[current=location]:text-ink"
          >
            <span class="size-1.5 shrink-0 rounded-full group-aria-[current=location]:bg-accent" aria-hidden="true"></span>
            {text}
          </a>
        ))}
      </nav>
    )}

    <div class="mt-auto flex items-center justify-between gap-3 border-t border-line pt-6">
      <div class="flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex size-10 items-center justify-center rounded-[10px] bg-accent-soft font-mono text-[13px] font-medium text-accent"
        >
          DC
        </span>
        <div class="flex flex-col gap-0.5">
          <span class="text-sm font-semibold">{SITE.author}</span>
          <a href="/sobre" class="text-[13px] text-muted">Sobre mim →</a>
        </div>
      </div>
      <ThemeToggle />
    </div>
  </Fragment>

  <article class="max-w-[720px]">
    <div class="mb-4 flex flex-wrap items-center gap-2 font-mono text-xs text-muted lg:hidden">
      <time datetime={date.toISOString()}>{published}</time>
      <CategoryBadge category={category} />
      <span>{minutes} min</span>
    </div>

    <h1 class="text-[28px] leading-[1.15] font-semibold tracking-[-0.02em] sm:text-[42px]">{title}</h1>
    <p class="mt-4 text-lg leading-normal text-muted sm:text-xl">{description}</p>

    {resumo && (
      <aside id="resumo" aria-labelledby="resumo-titulo" class="mt-9 scroll-mt-6 rounded-[14px] border border-line bg-surface px-5 py-5 sm:px-7 sm:py-6">
        <h2 id="resumo-titulo" class="font-mono text-xs font-normal text-muted">resumo</h2>
        <dl class="mt-4 grid gap-x-4 gap-y-1 sm:grid-cols-[140px_minmax(0,1fr)] sm:gap-y-3">
          {resumoItems.map(({ label, text }) => (
            <>
              <dt class="mt-2 font-mono text-[13px] text-accent first:mt-0 sm:mt-0">{label}</dt>
              <dd class="text-base leading-[1.55]">{text}</dd>
            </>
          ))}
        </dl>
      </aside>
    )}

    <div class="prose-blog mt-10">
      <slot />
    </div>

    {tags && tags.length > 0 && (
      <div class="mt-10 flex flex-wrap gap-x-2.5 gap-y-1 font-mono text-xs text-muted lg:hidden">
        {tags.map((tag) => <span>#{tag}</span>)}
      </div>
    )}

    {related.length > 0 && (
      <section class="mt-16 flex flex-col gap-4">
        <h2 class="font-mono text-xs font-normal text-muted">continue lendo</h2>
        <div class="grid gap-4 sm:grid-cols-2">
          {related.map((other) => (
            <a
              href={`/blog/${other.id}/`}
              class="group flex flex-col gap-2 rounded-xl border border-line bg-surface p-5 text-ink hover:border-muted hover:text-ink hover:no-underline"
            >
              <span class="font-mono text-xs text-muted">
                {formatDayMonth(other.data.date)} · {other.data.category}
              </span>
              <span class="text-[17px] leading-snug font-medium group-hover:text-accent">{other.data.title}</span>
            </a>
          ))}
        </div>
      </section>
    )}
  </article>
</BaseLayout>

<script>
  // Code blocks: language label and copy button.
  document.querySelectorAll<HTMLPreElement>('.prose-blog pre').forEach((pre) => {
    const wrapper = document.createElement('div');
    wrapper.className = 'code-block';

    const bar = document.createElement('div');
    bar.className = 'code-block-bar';

    const language = document.createElement('span');
    language.textContent = pre.dataset.language ?? '';

    const copy = document.createElement('button');
    copy.type = 'button';
    copy.className = 'code-block-copy';
    copy.textContent = 'copiar';
    copy.addEventListener('click', async () => {
      await navigator.clipboard.writeText(pre.innerText);
      copy.textContent = 'copiado';
      setTimeout(() => (copy.textContent = 'copiar'), 1500);
    });

    bar.append(language, copy);
    pre.replaceWith(wrapper);
    wrapper.append(bar, pre);
  });

  // Table of contents: mark the section being read.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc] a')];
  const sections = links
    .map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1))))
    .filter((section): section is HTMLElement => section !== null);

  function markCurrent() {
    const passed = sections.filter((section) => section.getBoundingClientRect().top < 120);
    const current = passed.at(-1) ?? sections[0];
    links.forEach((link) => {
      const isCurrent = current !== undefined && decodeURIComponent(link.hash.slice(1)) === current.id;
      if (isCurrent) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    });
  }

  if (sections.length > 0) {
    markCurrent();
    document.addEventListener('scroll', () => requestAnimationFrame(markCurrent), { passive: true });
  }
</script>

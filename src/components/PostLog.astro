---
import CategoryBadge from './CategoryBadge.astro';
import { formatDayMonth, groupByMonth, type Post } from '../utils/posts';

interface Props {
  posts: Post[];
  class?: string;
}

const { posts, class: className } = Astro.props;
const groups = groupByMonth(posts);
---

<div class:list={['flex flex-col gap-7 sm:gap-8', className]}>
  {groups.map(({ label, posts }) => (
    <section class="flex flex-col">
      <h2 class="mb-1 font-mono text-xs font-normal text-muted">{label}</h2>
      {posts.map((post) => (
        <a
          href={`/blog/${post.id}/`}
          class="group grid grid-cols-1 gap-1.5 border-b border-line py-4 text-ink hover:text-ink hover:no-underline sm:grid-cols-[80px_minmax(0,1fr)_auto] sm:items-start sm:gap-6 sm:py-5"
        >
          <div class="flex items-center gap-2">
            <time datetime={post.data.date.toISOString()} class="font-mono text-xs text-muted sm:text-[13px] sm:leading-[25px]">
              {formatDayMonth(post.data.date)}
            </time>
            <CategoryBadge category={post.data.category} class="sm:hidden" />
          </div>
          <div class="flex flex-col gap-1">
            <h3 class="text-[17px] leading-snug font-medium group-hover:text-accent sm:text-lg">{post.data.title}</h3>
            <p class="hidden text-[15px] leading-normal text-muted sm:block">{post.data.description}</p>
          </div>
          <CategoryBadge category={post.data.category} class="hidden justify-self-end sm:mt-0.5 sm:inline-flex" />
        </a>
      ))}
    </section>
  ))}
</div>

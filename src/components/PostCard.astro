---
import CategoryBadge from './CategoryBadge.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
  compact?: boolean;
}

const { post, compact = false } = Astro.props;
const { title, date, description, category } = post.data;
const slug = post.slug;

const formattedDate = date.toLocaleDateString('pt-BR', {
  day: '2-digit',
  month: 'short',
  year: compact ? undefined : 'numeric',
});
---

{compact ? (
  <a
    href={`/blog/${slug}`}
    class="flex items-baseline gap-4 py-2.5 group no-underline hover:opacity-75 transition-opacity"
    style="color: var(--color-text)"
  >
    <time class="text-sm shrink-0 tabular-nums" style="color: var(--color-muted)" datetime={date.toISOString()}>
      {formattedDate}
    </time>
    <div class="flex items-center gap-3 min-w-0">
      <CategoryBadge category={category} />
      <span class="text-sm truncate">{title}</span>
    </div>
    <span class="ml-auto shrink-0 text-sm" style="color: var(--color-muted)">→</span>
  </a>
) : (
  <article class="py-5" style="border-bottom: 1px solid var(--color-border)">
    <a href={`/blog/${slug}`} class="group no-underline block" style="color: var(--color-text)">
      <div class="flex items-center gap-3 mb-2">
        <CategoryBadge category={category} />
        <time class="text-xs" style="color: var(--color-muted)" datetime={date.toISOString()}>
          {formattedDate}
        </time>
      </div>
      <h2 class="text-base font-semibold mb-1.5 group-hover:opacity-75 transition-opacity">
        {title}
      </h2>
      <p class="text-sm leading-relaxed" style="color: var(--color-muted)">{description}</p>
    </a>
  </article>
)}

---
import { SITE } from '../consts';
import SocialLinks from './SocialLinks.astro';

const year = new Date().getFullYear();
---

<footer class="mt-16 flex flex-col gap-3 border-t border-line pt-6 pb-10 font-mono text-xs text-muted sm:mt-20 sm:pb-12">
  <SocialLinks class="lg:hidden" />
  <div class="flex flex-col gap-1 sm:flex-row sm:justify-between">
    <span>© {year} {SITE.author}</span>
    <span>feito com Astro · hospedado no GitHub Pages</span>
  </div>
</footer>
